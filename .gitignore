__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
dist/
build/
.env
.env.*
!.env.example
wandb/
# models/ stays ignored except the frozen serving artifacts — Railway builds the worker
# image from the repo, so the baked triplet and its surrogate must be committed (F-26;
# decision Q1, 22 Jul 2026). Training and ablation run dirs never come in. `dir/*` +
# negations, not `dir/`: git will not descend into a fully ignored directory to honour a
# re-include. data/circuits/ was in this sentence until F18 and never belonged in it —
# the ribbon library has been committed whole since the decision below.
models/*
# the run ledger is the ablation table's machine-readable twin (F08) — a clean clone
# without it has no record of what was trained, so it is committed (F15)
!models/runs.json
!models/headline
!models/era2024
!models/explain
models/explain/*
# by pattern, not by checkpoint name: make explain writes to a directory named after the
# model version, so a refit or retrain produces a new name. Pinning the old names meant a
# regenerated surrogate landed silently ignored, and a clean clone could then not serve
# (serve/loader.py raises on the missing artifact). Nothing failed — the files just never
# reached git. F18 found it; the wildcard is what stops it recurring.
!models/explain/senna-ppo-*
# the two evaluation-only arrays are reproducible from make explain and serve nothing
models/explain/*/holdout.npz
models/explain/*/crosscheck.npz
data/cache/
# the frozen A-09 dump rides the tagged GitHub release, never git history; its
# committed half is data/snapshot/MANIFEST.md (make snapshot writes both)
data/snapshot/*.dump
# the ribbon library is a committed artifact (INDEX decision 22 Jul 2026): a clean
# clone must show every buildable circuit, so nothing under data/circuits is ignored
fastf1_cache/
*.parquet
.DS_Store
*.tsbuildinfo

# uv creates this on `uv run`; this project locks via requirements.txt (make lock)
uv.lock

# staged for manual deletion
_to_delete/
