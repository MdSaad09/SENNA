# Copy to .env and adjust. Values match docker-compose.yml for local work.
DATABASE_URL=postgresql+asyncpg://senna:senna@localhost:5432/senna
REDIS_URL=redis://localhost:6379/0

# Which baked triplet the serving layer runs (5.11.2, F-26). Unset or dev-latest
# means models/headline; a version the image does not bake fails loudly at startup.
# MODEL_VERSION=dev-latest

# The loader looks under <repo>/models by default; override only if the artifacts
# live elsewhere (never on Railway — the image bakes them at /app/models).
# MODELS_DIR=/somewhere/else/models

# pytest's DB tests DROP AND RECREATE every table — point them at their own
# database (create once: docker compose exec postgres psql -U senna -d senna
# -c 'create database senna_test'), never at the ingested one.
# TEST_DATABASE_URL example for local runs:
#   DATABASE_URL=postgresql+asyncpg://senna:senna@localhost:5432/senna_test pytest
